{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://da3-cad.local/schemas/config.schema.json",
  "title": "DA3-CAD configuration",
  "type": "object",
  "required": ["profile", "device", "seed", "depth_backend", "cad_backend"],
  "properties": {
    "profile": {"enum": ["stub", "research", "permissive"]},
    "device": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "debug_artefacts": {"type": "boolean"},
    "depth_backend": {"type": "string", "minLength": 1},
    "cad_backend": {"type": "string", "minLength": 1},
    "sandbox": {
      "type": "object",
      "required": ["memory_limit_mb", "cpu_seconds", "wall_seconds"],
      "properties": {
        "memory_limit_mb": {"type": "integer", "minimum": 512},
        "cpu_seconds": {"type": "integer", "minimum": 1},
        "wall_seconds": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

