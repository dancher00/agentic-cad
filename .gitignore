coverage.xml
dist/
build/

# Runtime assets and outputs are never committed.
/data/
/weights/
/cache/
/outputs/
/results/
/captures/

# Ad-hoc local captures supplied for manual reconstruction experiments.
/mug*.jpg
*.safetensors
*.ckpt
*.pth

# Generated sample artefacts are rebuilt from source; the shipped fixture is
# explicitly unignored below.
sample_data/*/generated/

# Local paper builds.
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.pdf
paper/revival/*.aux
paper/revival/*.bbl
paper/revival/*.blg
paper/revival/*.log
paper/revival/*.out
paper/revival/main.pdf

# Local editor/OS metadata and benchmark scratch files.
.DS_Store
Thumbs.db
*.swp
*.swo
/.claude/settings.local.json

# Product runs can include private prompts, photos and provider responses.
/work/
.env
.env.*
